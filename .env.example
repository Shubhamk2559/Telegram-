# =============================================================================
# telegram_media_project - configuration template
# Isko `.env` naam se copy karo (local) ya Koyeb me Environment variables / Secrets me daalo.
# `.env`, session files aur tokens kabhi Git me commit mat karo.
#
# Naam: yahan spec wale naam dikhaye hain. Purane naam (API_ID, CHANNEL_ID, DISKWALA_BOT, ...) bhi chalte hain;
# dono set hon to PURANA naam jeetta hai. Purana naam har line ke saath comment me likha hai.
# Secrets ke saath [SECRET] likha hai: ye logs me kabhi print nahi hote.
# =============================================================================

# ---------- Telegram ----------
# my.telegram.org se.                                                  (old: API_ID)
TELEGRAM_API_ID=
# [SECRET]                                                             (old: API_HASH)
TELEGRAM_API_HASH=
# [SECRET] Koyeb par ZAROORI. Local par `python -m src.main login` karke
# `python -m src.app export-session` se nikalo.                        (old: SESSION_STRING)
TELEGRAM_SESSION_STRING=
# SAVED MESSAGES se kaam karna hai to FILE_MANAGER_CHANNEL_ID KHAALI rakho aur neeche CHANNEL_NAME=Saved Messages do.
# (Kisi aur channel se chahiye to uska numeric id, jaise -1001234567890.)     (old: CHANNEL_ID)
FILE_MANAGER_CHANNEL_ID=
CHANNEL_NAME=Saved Messages
# Local file-session ka naam (sirf local use)
# SESSION_NAME=file_manager
# Jahan final posts publish hon (alag channel/chat id)
FINAL_POST_DESTINATION_ID=
# Pehli baar scan par purani history queue NAHI hoti. Purane ZIPs bhi chahiye to message id do.
# SCAN_BACKFILL_FROM_MESSAGE_ID=

# ---------- File Manager me seedhe bheji image/video (ZIP ke bina) ----------
# true = image(s) + video(s) ko batch maan ke ZIP jaisa process karo. Batch: image(s) phir video(s);
# video ke baad nayi image aate hi naya batch. Telegram me images "File" (document) ke roop me bhejo,
# warna Telegram khud compress kar deta hai (photo = compressed).
MEDIA_BATCHES_ENABLED=true
# Aakhri message ke itne second baad (aur koi nayi image/ZIP na aaye) to batch band maan ke process hoga.
# Bade video upload me der lagti ho to isse badhao.
MEDIA_BATCH_QUIET_SECONDS=180
# Video ka bhejna: video DOWNLOAD NAHI hota, Telegram server-side bot ko bhejta hai (bandwidth ~0).
#   media   = bina "Forwarded from" ke (default)
#   forward = asli forward
VIDEO_SEND_MODE=media

# ---------- ImgBB ----------
# [SECRET] https://api.imgbb.com/
IMGBB_API_KEY=
# Do image uploads ke beech gap (seconds).                             (old: IMGBB_DELAY_SECONDS)
IMGBB_UPLOAD_DELAY_SECONDS=5
# Ek image ke liye retries (429/5xx/network, exponential backoff).      (old: IMGBB_RETRIES)
IMGBB_MAX_RETRIES=5
# pause = koi image fail ho to ZIP pause; skip = baaki images ke saath aage badho (report me dikhegi)
IMAGE_FAILURE_POLICY=pause

# ---------- Telegraph ----------
# [SECRET] Khaali chhodo: pehli baar account ban ke DATABASE me save hota hai.
TELEGRAPH_ACCESS_TOKEN=
# Har ZIP ke article ka fixed title (ZIP filename nahi).               (old: TELEGRAPH_TITLE)
TELEGRAPH_ARTICLE_TITLE=My Image Collection
TELEGRAPH_AUTHOR=
# true = jab tak sab images verify na hon ZIP aage nahi badhega
TELEGRAPH_REQUIRE_VERIFIED=false

# ---------- DiskWala ----------
# Bot ka username (@ ke bina).                                         (old: DISKWALA_BOT)
DISKWALA_BOT_USERNAME=DiskWalaFileUploaderBot
# Ek video ke link ka intezaar (seconds).                              (old: UPLOAD_RESPONSE_TIMEOUT)
DISKWALA_RESPONSE_TIMEOUT_SECONDS=1800
# Ek video ke liye max sends ek run me.                                (old: UPLOAD_RETRIES)
DISKWALA_MAX_RETRIES=3
# Timeout par resend karna hai? (pehle late-reply check hota hai)
DISKWALA_RESEND_ON_TIMEOUT=true
DISKWALA_LATE_REPLY_GRACE_SECONDS=300
# Sirf in domains ke links maane jayein (comma separated). Khaali = koi bhi http(s) link.
# DISKWALA_LINK_DOMAINS=diskwala.com
# document ya video
# UPLOAD_AS=document
# Bot ko bhejne wale videos ki max size (MB); 0 = default
# MAX_UPLOAD_MB=0
# Do videos ke beech gap aur polling (seconds)
# UPLOAD_DELAY_SECONDS=3
# UPLOAD_POLL_SECONDS=3
# Telegram FloodWait itne seconds se zyada ho to ruko
# MAX_FLOOD_WAIT_SECONDS=900

# ---------- File rename (bhejne se PEHLE) ----------
# Videos: sabse bada size = "<base> 01.mp4", usse chota 02, ... (har ZIP me 01 se). Khaali = rename nahi.
VIDEO_NAME_BASE=Trader Master
# Images: ZIP ke natural order me "<base> 01.jpg", "<base> 02.jpg", ... Khaali = rename nahi.
IMAGE_NAME_BASE=Trader Master

# ---------- Final Telegram post ----------
# Variables: {telegraph_url} (pehla page), {telegraph_urls} (saare pages, har line me ek), {video_links}
# \n likhne par asli newline banta hai. Unicode/emoji chalte hain.
FINAL_POST_TEMPLATE="Articles Images {telegraph_url}\n\nVideo links {video_links}"
# Sirf images wale ZIP ke liye ({video_links} yahan allowed nahi)
FINAL_POST_TEMPLATE_IMAGES_ONLY="Articles Images {telegraph_url}"
# Sirf videos wale ZIP ke liye ({telegraph_url} yahan allowed nahi)
FINAL_POST_TEMPLATE_VIDEOS_ONLY="Video links {video_links}"
# 1 se 8 (spec: ek post me max 8)
MAX_VIDEO_LINKS_PER_POST=8
# Posts me link preview (Telegraph card) dikhe?
POST_LINK_PREVIEW=false

# ---------- Database ----------
# [SECRET] Production me PostgreSQL: postgresql://user:password@host:5432/dbname?sslmode=require
# Khaali = local SQLite (workspace/app.db) - sirf local testing, Koyeb par nahi.
DATABASE_URL=

# ---------- Worker ----------
WORKER_POLL_INTERVAL_SECONDS=30
# Sirf 1 supported hai (strict ZIP-by-ZIP)
MAX_CONCURRENT_ZIPS=1
# Ek stage ke temporary errors par kitne retries, phir ZIP PAUSED
STAGE_MAX_RETRIES=5
# ZIP COMPLETED hone par uski download + extracted files delete
CLEANUP_AFTER_COMPLETE=true

# ---------- Storage / safety limits ----------
# Workspace (temporary files). Koyeb par disk ephemeral hai.
# WORKSPACE_DIR=workspace
# Disk chahiye ~ MAX_ARCHIVE_MB + MAX_EXTRACTED_MB + MIN_FREE_DISK_MB. `python -m src.app doctor` check karta hai.
# MAX_ARCHIVE_MB=2048
# MAX_EXTRACTED_MB=4096
# MAX_FILES=10000
# MAX_COMPRESSION_RATIO=200
# MIN_FREE_DISK_MB=500

# ---------- Health endpoint / Logging ----------
# Koyeb Web Service par PORT khud set hota hai. Worker service par isse fark nahi padta.
# PORT=8000
# HEALTH_PORT=8000
HEALTH_ENABLED=true
LOG_LEVEL=INFO
